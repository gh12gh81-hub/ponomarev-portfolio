# Public Cloudinary identifier (used by the website bundle)
VITE_CLOUDINARY_CLOUD_NAME=

# Server-only admin authentication
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Server-only signed Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-only GitHub Contents API access
GITHUB_REPOSITORY=gh12gh81-hub/ponomarev-portfolio
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Use only for local development. Never set this on Vercel.
ADMIN_STORAGE=local
